# 비밀키 — 절대 커밋 금지
.env
.env.*
# 단, 빈 템플릿은 싣는다. `.env.*`가 이것까지 막는다.
!.env.example

# Claude/harness 작업 메타데이터 — 제출 레포에 포함하지 않음
.claude/
.harness-mem/
.claude-plugin/
hooks/
harness.toml

# harness 생성물
out/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# data/ 는 통째로 무시하지 않는다. 무시할 파일만 지정한다.
# ⛔ `data/`·`data/postings/`를 통째로 넣으면 provenance.json(출처 증거)·
#    requirements.json(파싱 결과)·data/resumes/**(제출물)·data/runs/**(실행 기록)이
#    전부 사라진다. 이미지를 뺀 대가로 남긴 유일한 증거가 해시인데 그 파일까지 없어진다.
#
# ⚠️ gitignore에는 **줄 끝 주석이 없다.** `pattern  # 설명`은 패턴의 일부가 되어
#    아무것도 안 막는다. 설명은 반드시 패턴 위 줄에 쓴다.

# 공고 이미지 원본
data/postings/*/img_*.png
# 이미지의 전사본 = 공고 본문 그 자체
data/postings/*/ocr.json
# 호출 기록 (로컬 상태)
data/.saramin_quota.json
# 토큰·비용 누적 (로컬 상태)
data/.judge_usage.json

# --- 제작 과정 메타데이터. 제출물이 아니다 ---
# 하네스 step 정의 (작업 지시서)
phases/
# 진행 상황 추적
Plans.md
# 계획 심사 이력
docs/HARNESS_SCOREBOARD.md
# 실행기 검증 기록
docs/HARNESS_VALIDITY.md
# 하네스 실행기 — 외부 스켈레톤이지 우리 코드가 아니다
scripts/
# 스파이크 가상환경
spike/.venv/
# 컴파일 산출물
spike/ocr_check/.vision_ocr
